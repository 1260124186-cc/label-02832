# ============================================
# 通用忽略规则 - 适用于所有子项目
# ============================================

# 依赖目录
**/node_modules/
**/vendor/
.pnp
.pnp.js

# 构建产物
**/dist/
**/dist-ssr/
**/build/
**/.output/
**/.nuxt/
**/.next/
*.local

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编辑器目录和文件
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 环境变量文件
.env
.env.*
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 测试覆盖率
coverage/
*.lcov
.nyc_output/
test-results/

# 缓存目录
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# 临时文件
*.tmp
*.temp
.tmp/
.temp/
tmp/
temp/

# 打包文件
*.tgz
*.tar.gz
*.zip
*.rar

# Docker相关
docker-compose.override.yml
.docker/

# Python相关 (如有后端服务)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
.venv/
*.egg-info/
.eggs/

# Java相关 (如有后端服务)
*.class
*.jar
*.war
*.ear
target/

# Go相关 (如有后端服务)
*.exe
*.exe~
*.dll
*.so
*.dylib

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 秘钥和证书
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
secrets/
credentials/

# IDE 特定配置
.settings/
.classpath
.project
*.iml
.gradle/
